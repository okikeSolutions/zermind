{
  "name": "zermind",
  "version": "0.2.0",
  "private": true,
  "description": "Zermind is a modern, open-source AI chat app",
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3000",
    "generate:i18n": "bun scripts/generate-i18n.ts",
    "generate-routes": "tsr generate",
    "build": "NODE_ENV=production vite build",
    "start": "node --env-file-if-exists=.env --env-file-if-exists=.env.local .output/server/index.mjs",
    "preview": "vite preview",
    "typecheck": "bun run generate:i18n && tsc --noEmit",
    "test": "bun run generate:i18n && vitest run",
    "lint": "oxlint",
    "audit:copy": "bun scripts/audit-copy.ts --fail-on-jsx",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.96",
    "@ai-sdk/google": "^4.0.111",
    "@ai-sdk/openai": "^4.0.108",
    "@base-ui/react": "^1.9.0",
    "@convex-dev/agent": "^0.7.9",
    "@convex-dev/better-auth": "^0.13.0",
    "@convex-dev/presence": "^0.4.0",
    "@convex-dev/rate-limiter": "^0.4.3",
    "@convex-dev/react-query": "^0.1.0",
    "@hookform/resolvers": "^7.0.2",
    "@openrouter/ai-sdk-provider": "^3.1.0",
    "@stylexjs/stylex": "^0.19.1",
    "@tanstack/react-query": "^5.105.3",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-router-ssr-query": "^1.167.3",
    "@tanstack/react-start": "1.169.4",
    "@xyflow/react": "^12.12.1",
    "ai": "^7.0.162",
    "better-auth": "1.7.16",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.49.0",
    "lucide-react": "^1.68.0",
    "nanoid": "^6.0.2",
    "next-themes": "^0.4.6",
    "nitro": "3.0.261103-rc",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-dropzone": "^20.1.4",
    "react-error-boundary": "^6.1.6",
    "react-hook-form": "^7.91.0",
    "sonner": "^2.0.8",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@inlang/paraglide-js": "^3.1.0",
    "@stylexjs/unplugin": "^0.19.1",
    "@tanstack/router-cli": "^1.167.46",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/typescript6": "6.0.2",
    "@vitejs/plugin-react": "^6.2.1",
    "oxfmt": "^0.76.0",
    "oxlint": "^1.91.0",
    "oxlint-tsgolint": "^7.0.2005",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "esbuild": "0.28.2",
    "path-to-regexp": "6.3.0"
  },
  "engines": {
    "node": "^22.22.0 || ^24.0.0 || >=26.0.0"
  },
  "packageManager": "bun@1.3.13"
}

{
  "name": "zermind",
  "version": "0.2.0",
  "private": true,
  "description": "Zermind is a modern, open-source AI chat app",
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3000",
    "generate:i18n": "bun scripts/generate-i18n.ts",
    "generate-routes": "tsr generate",
    "build": "NODE_ENV=production vite build",
    "start": "node --env-file-if-exists=.env --env-file-if-exists=.env.local .output/server/index.mjs",
    "preview": "vite preview",
    "typecheck": "bun run generate:i18n && tsc --noEmit",
    "test": "bun run generate:i18n && vitest run",
    "lint": "oxlint",
    "audit:copy": "bun scripts/audit-copy.ts --fail-on-jsx",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.71",
    "@ai-sdk/google": "^3.0.64",
    "@ai-sdk/openai": "^3.0.53",
    "@base-ui/react": "^1.7.0",
    "@convex-dev/agent": "^0.6.1",
    "@convex-dev/better-auth": "^0.12.5",
    "@convex-dev/presence": "^0.3.0",
    "@convex-dev/rate-limiter": "^0.3.2",
    "@convex-dev/react-query": "^0.1.0",
    "@hookform/resolvers": "^5.2.2",
    "@openrouter/ai-sdk-provider": "^2.8.1",
    "@stylexjs/stylex": "^0.19.0",
    "@tanstack/react-query": "^5.102.3",
    "@tanstack/react-router": "^1.170.32",
    "@tanstack/react-router-ssr-query": "^1.167.1",
    "@tanstack/react-start": "^1.168.49",
    "@xyflow/react": "^12.10.2",
    "ai": "^6.0.168",
    "better-auth": "1.6.22",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.45.0",
    "lucide-react": "^1.11.0",
    "nanoid": "^5.1.16",
    "next-themes": "^0.4.6",
    "nitro": "3.0.260610-beta",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-dropzone": "^15.0.0",
    "react-error-boundary": "^6.1.1",
    "react-hook-form": "^7.74.0",
    "sonner": "^2.0.7",
    "zod": "^4.3.6",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@inlang/paraglide-js": "^2.24.1",
    "@stylexjs/unplugin": "^0.19.0",
    "@tanstack/router-cli": "^1.167.33",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vercel/config": "^0.6.1",
    "@vitejs/plugin-react": "^6.1.0",
    "oxfmt": "^0.46.0",
    "oxlint": "^1.61.0",
    "oxlint-tsgolint": "^0.22.0",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "esbuild": "0.28.2",
    "path-to-regexp": "6.3.0"
  },
  "packageManager": "bun@1.3.13"
}

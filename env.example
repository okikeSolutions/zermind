# OpenRouter API Configuration
# Get your API key from: https://openrouter.ai/keys
# Don't forget to set a credit limit to avoid suprising bills!!!
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Encryption Secret for BYOK encryption
API_KEY_ENCRYPTION_SECRET=your-api-key-encryption-secret

# Model Providers
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GOOGLE_GENERATIVE_AI_API_KEY=your_google_generative_ai_api_key_here

# Convex
NEXT_PUBLIC_CONVEX_URL=your_convex_deployment_url
NEXT_PUBLIC_CONVEX_SITE_URL=your_convex_site_url
SITE_URL=http://localhost:3000

# Better Auth OAuth providers
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Legacy Prisma/Postgres configuration, only needed until all data APIs are moved to Convex
DATABASE_URL=your_database_connection_string

# NODE ENV
NODE_ENV=development

# SEO
NEXT_PUBLIC_SITE_URL=your-production-url